#!/usr/bin/env bash
# Run static analysis on exactly what is being pushed (not the working tree).
# Enable once per clone:  git config core.hooksPath .githooks
set -uo pipefail
REPO=$(git rev-parse --show-toplevel)
ZERO=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue   # branch deletion
  if [ "$remote_sha" = "$ZERO" ]; then range="$local_sha --not --remotes"; else range="$remote_sha..$local_sha"; fi
  echo "pre-push: checking $local_ref -> $remote_ref (${local_sha:0:7})"
  tree=$(mktemp -d)
  git -C "$REPO" archive "$local_sha" | tar -x -C "$tree"
  "$REPO/scripts/static-analysis.sh" "$tree" "$range" || status=1
  rm -rf "$tree"
done
[ "$status" -eq 0 ] || echo "pre-push: blocked. Fix the findings above (or bypass once with git push --no-verify)."
exit "$status"
