# Copy to .env (gitignored) and fill in.
# King Coopa API that the dashboard reads info from.
KC_INFO_URL=http://<pi-address>:8080
# Where open/close/restart/reconfigure go. Leave on the fake host until controls should be live.
KC_CONTROL_URL=http://fake-king-coopa.invalid:8080

# --- Optional coop camera (docker compose --profile camera up -d --build) ---
# go2rtc relay inside the dashboard's network namespace. Leave empty to hide the camera card.
KC_GO2RTC_URL=http://127.0.0.1:1984
# Camera address and its Tapo "Camera Account" (Tapo app > camera > Advanced settings).
# URL-encode the username and password (e.g. @ -> %40, $ -> %24).
KC_CAMERA_HOST=<camera-address>
TAPO_USER=
TAPO_PASS=
